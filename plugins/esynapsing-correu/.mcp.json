{
  "mcpServers": {
    "correo": {
      "command": "node",
      "args": [
        "./dist/start.mjs"
      ],
      "cwd": ".",
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 90,
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "ACCOUNT1_LABEL",
        "ACCOUNT1_EMAIL",
        "ACCOUNT1_PASSWORD",
        "ACCOUNT1_SENDER_NAME",
        "ACCOUNT1_PROVIDER",
        "ACCOUNT1_SMTP_HOST",
        "ACCOUNT1_SMTP_PORT",
        "ACCOUNT1_IMAP_HOST",
        "ACCOUNT1_IMAP_PORT",
        "ACCOUNT2_LABEL",
        "ACCOUNT2_EMAIL",
        "ACCOUNT2_PASSWORD",
        "ACCOUNT2_SENDER_NAME",
        "ACCOUNT2_PROVIDER",
        "ACCOUNT2_SMTP_HOST",
        "ACCOUNT2_SMTP_PORT",
        "ACCOUNT2_IMAP_HOST",
        "ACCOUNT2_IMAP_PORT",
        "ACCOUNT3_LABEL",
        "ACCOUNT3_EMAIL",
        "ACCOUNT3_PASSWORD",
        "ACCOUNT3_SENDER_NAME",
        "ACCOUNT3_PROVIDER",
        "ACCOUNT3_SMTP_HOST",
        "ACCOUNT3_SMTP_PORT",
        "ACCOUNT3_IMAP_HOST",
        "ACCOUNT3_IMAP_PORT",
        "SAVE_TO_SENT",
        "ALLOWED_RECIPIENT_DOMAINS",
        "MAX_RECIPIENTS_PER_EMAIL",
        "MAX_EMAILS_PER_DAY",
        "MAX_ATTACHMENT_MB",
        "ATTACHMENTS_DIR",
        "SIGNATURE_HTML",
        "READABLE_FOLDERS",
        "MAX_BODY_CHARS",
        "MAX_SEARCH_RESULTS",
        "DOWNLOADS_DIR",
        "MAX_DOWNLOAD_MB"
      ]
    }
  }
}
